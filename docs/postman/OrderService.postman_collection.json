{
  "info": {
    "_postman_id": "f7c3e9a1-2b4d-4e6f-8a0c-1d2e3f4a5b6c",
    "name": "OrderService API",
    "description": "Collection oficial do OrderService (Nstech Challenge).\n\nFluxo sugerido:\n1. Auth → Issue Token\n2. Happy Path → Create → Get → List → Confirm → Cancel\n3. Edge Cases conforme o guia em docs/testing-guide.md\n\nPré-requisito: `docker compose up --build` e environment **OrderService — Docker**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "demo" },
    { "key": "password", "value": "demo" },
    { "key": "accessToken", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "customerId", "value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa" },
    { "key": "productIdA", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "productIdB", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "productIdC", "value": "33333333-3333-3333-3333-333333333333" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 — Health",
      "item": [
        {
          "name": "GET Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Healthcheck operacional da API."
          }
        }
      ]
    },
    {
      "name": "01 — Auth",
      "item": [
        {
          "name": "POST Auth Token (sucesso)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Retorna accessToken', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
                  "pm.test('TokenType Bearer', () => pm.expect(body.tokenType).to.eql('Bearer'));",
                  "pm.test('ExpiresIn > 0', () => pm.expect(body.expiresIn).to.be.above(0));",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.environment.set('accessToken', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/token",
            "description": "Emite JWT. Salva automaticamente `accessToken` na collection/environment."
          }
        },
        {
          "name": "POST Auth Token (credenciais inválidas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo\",\n  \"password\": \"wrong-password\"\n}"
            },
            "url": "{{baseUrl}}/auth/token",
            "description": "Deve rejeitar credenciais inválidas com 401."
          }
        }
      ]
    },
    {
      "name": "02 — Happy Path",
      "item": [
        {
          "name": "POST Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Status Placed', () => pm.expect(body.status).to.eql('Placed'));",
                  "pm.test('Total = 20.00 (2 x 10)', () => pm.expect(Number(body.total)).to.eql(20));",
                  "pm.test('Possui itens', () => pm.expect(body.items).to.be.an('array').and.have.lengthOf(1));",
                  "pm.collectionVariables.set('orderId', body.id);",
                  "pm.environment.set('orderId', body.id);",
                  "pm.environment.set('orderIdConfirm', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"currency\": \"BRL\",\n  \"items\": [\n    {\n      \"productId\": \"{{productIdA}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/orders",
            "description": "Cria pedido Placed. Salva `orderId` para os próximos requests."
          }
        },
        {
          "name": "GET Order By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Id corresponde', () => pm.expect(body.id).to.eql(pm.environment.get('orderId') || pm.collectionVariables.get('orderId')));",
                  "pm.test('Retorna itens', () => pm.expect(body.items.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}",
            "description": "Consulta pedido + itens."
          }
        },
        {
          "name": "GET List Orders (paginado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Paginação presente', () => {",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.pageSize).to.eql(20);",
                  "  pm.expect(body.items).to.be.an('array');",
                  "  pm.expect(body.totalCount).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?customerId={{customerId}}&status=Placed&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "customerId", "value": "{{customerId}}" },
                { "key": "status", "value": "Placed" },
                { "key": "from", "value": "", "disabled": true },
                { "key": "to", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            },
            "description": "Lista pedidos com filtros e paginação."
          }
        },
        {
          "name": "POST Confirm Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Status Confirmed', () => pm.expect(body.status).to.eql('Confirmed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/confirm",
            "description": "Confirma pedido Placed → Confirmed e baixa estoque."
          }
        },
        {
          "name": "POST Confirm Order (idempotente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Permanece Confirmed', () => pm.expect(body.status).to.eql('Confirmed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/confirm",
            "description": "Segunda confirmação deve manter o mesmo resultado (idempotência)."
          }
        },
        {
          "name": "POST Cancel Order (após confirm)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Status Canceled', () => pm.expect(body.status).to.eql('Canceled'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/cancel",
            "description": "Cancela pedido Confirmed e libera estoque."
          }
        },
        {
          "name": "POST Cancel Order (idempotente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Permanece Canceled', () => pm.expect(body.status).to.eql('Canceled'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/cancel",
            "description": "Segundo cancelamento deve manter o mesmo resultado (idempotência)."
          }
        }
      ]
    },
