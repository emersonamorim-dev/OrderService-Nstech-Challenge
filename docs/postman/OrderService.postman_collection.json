              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"currency\": \"BRL\",\n  \"items\": [\n    {\n      \"productId\": \"{{productIdB}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/orders",
            "description": "Cria pedido Placed para cancelamento sem confirmação prévia."
          }
        },
        {
          "name": "POST Cancel Order (from Placed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Status Canceled', () => pm.expect(body.status).to.eql('Canceled'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/cancel",
