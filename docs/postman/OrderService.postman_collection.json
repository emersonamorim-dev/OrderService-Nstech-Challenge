          }
        },
        {
          "name": "POST Confirm pedido cancelado (estado inválido)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Requer orderId de um pedido já Canceled (rode pasta 02 ou 03 antes)."
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 Invalid order state', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}/confirm",
            "description": "Confirmar pedido Canceled deve falhar com 409 Invalid order state.\n\nPré-condição: `orderId` aponta para pedido já cancelado (execute Happy Path ou Cancel from Placed antes)."
          }
        },
        {
          "name": "GET List Orders com status inválido",
          "event": [
            {
              "listen": "test",
              "script": {
