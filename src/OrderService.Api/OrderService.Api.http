# Local (dotnet run / VS — perfil http): http://localhost:5232
# Docker compose (API container):      http://localhost:8080
@OrderService.Api_HostAddress = http://localhost:5232
@token =
@orderId = 

### Issue token
POST {{OrderService.Api_HostAddress}}/auth/token
Content-Type: application/json

{
  "username": "demo",
  "password": "demo"
}

### Create order
POST {{OrderService.Api_HostAddress}}/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerId": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
  "currency": "BRL",
  "items": [
    {
      "productId": "11111111-1111-1111-1111-111111111111",
      "quantity": 2
    }
  ]
}

### Confirm order
POST {{OrderService.Api_HostAddress}}/orders/{{orderId}}/confirm
Authorization: Bearer {{token}}

### Cancel order
POST {{OrderService.Api_HostAddress}}/orders/{{orderId}}/cancel
Authorization: Bearer {{token}}

### Get order
GET {{OrderService.Api_HostAddress}}/orders/{{orderId}}
Authorization: Bearer {{token}}

### List orders
GET {{OrderService.Api_HostAddress}}/orders?page=1&pageSize=20
Authorization: Bearer {{token}}
